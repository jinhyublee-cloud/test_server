<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      보안: 인터넷 권한이 없습니다. 어떤 라이브러리가 추가하려 해도 제거합니다.
      → 이 앱은 기록을 폰 밖으로 보낼 수 없습니다.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- 2.4: 기기 AI 라이브러리(ML Kit)가 넣는 통계 전송용 권한도 제거 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- S-04: 이 앱이 앞에 있을 때 다른 앱의 덮어쓰기 창을 숨김 -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- S-17: 모든 앱 목록 대신, 홈 화면에 아이콘이 있는 앱만 볼 수 있게 (앱 이름 표시·열기용) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="하루기록"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <!--
              폴드: 접기·펴기·회전·화면 분할 때 화면을 새로 만들지 않고 그대로 크기만 바꿈
              (새로 만들면 보던 탭이 홈으로 돌아가고, 잠금이 켜져 있으면 지문을 다시 물어봄)
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".capture.NotiListener"
            android:exported="true"
            android:label="하루기록 알림 수집"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 보안: 쓰지 않는 외부 노출 컴포넌트 제거 -->
        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <!-- 2.4: ML Kit 사용 통계 전송 통로 제거 (보낼 곳이 없으면 통계는 전송되지 않고 버려짐) -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
    </application>
</manifest>
